{
  "_說明": [
    "pvpoke 的型態後綴 → Pokémon GO 資產檔名裡的 form 代碼。",
    "檔名規則是 pm{圖鑑編號}[.f{FORM}].icon.png，form 代碼是 Niantic 自己的英文列舉，",
    "大多數情況把後綴轉大寫就對得上（Therian → THERIAN），這裡只收對不上的。",
    "值是候選陣列，依序試；空陣列代表這個後綴在資產裡沒有對應，直接退回該species的基本圖。",
    "解析順序與退回規則見 scripts/lib/icons.mjs。"
  ],
  "後綴": {
    "Alolan": ["ALOLA"],
    "Paldean": ["PALDEA"],
    "Aqua": ["PALDEA_AQUA"],
    "Blaze": ["PALDEA_BLAZE"],
    "Combat": ["PALDEA_COMBAT"],
    "Galarian": ["GALARIAN", "GALARIAN_STANDARD"],
    "Sunshine": ["SUNNY"],
    "Armored": ["A"],
    "Jr": [],
    "10% Forme": ["TEN_PERCENT"],
    "50% Forme": ["FIFTY_PERCENT"],
